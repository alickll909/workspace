      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(cut *)",
      "Bash(pwd)",
      "Bash(date)",
      "Bash(which *)",
      "Bash(file *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(ps *)",
      "Bash(env *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(tee *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
